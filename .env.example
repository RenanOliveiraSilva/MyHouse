# ==============================================================================
# 🏡 MYHOUSE · MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Duplique este arquivo e renomeie a cópia para ".env"
# 2. Preencha os valores abaixo com as credenciais do seu projeto Supabase
# 3. Reinicie o Expo com "npx expo start -c"
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚡ SUPABASE (Banco de Dados & Sincronização em Tempo Real)
# ------------------------------------------------------------------------------
# Crie um projeto gratuito em https://supabase.com
# Execute o script "supabase/schema.sql" no SQL Editor do painel
# Copie as credenciais em: Project Settings -> API
#
# URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública 'anon' 'public'
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ------------------------------------------------------------------------------
# 📱 CONFIGURAÇÕES GERAIS (OPCIONAL)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME="MyHouse · Projeto a Dois"
